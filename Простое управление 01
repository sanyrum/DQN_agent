import torch #для работы с многомерными массивами
import torch.nn as nn #для построения нейронной сети
import torch.optim as optim #для оптимизации
import random
import numpy as np
import pygame
import math

from collections import deque #для памяти

N_INPUTS = 8
N_ACTIONS = 9
HIDDEN = 64

LR = 0.0003
GAMMA = 0.85
BATCH_SIZE = 128
MEMORY_SIZE = 100_000
TARGET_UPDATE = 200

EPS_START = 1.0
EPS_END = 0.05
EPS_DECAY = 0.995

MAX_SPEED = 10


class QNetwork(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(N_INPUTS, HIDDEN), #слой
            nn.ReLU(), #ф-ция активации
            nn.Linear(HIDDEN, HIDDEN),
            nn.ReLU(),
            nn.Linear(HIDDEN, N_ACTIONS),
        )

    def forward(self, x):
        return self.net(x)


class ReplayBuffer:
    def __init__(self, capacity):
        self.buf = deque(maxlen=capacity)

    def push(self, state, action, reward, next_state, done):
        self.buf.append((state, action, reward, next_state, done))

    def sample(self, batch_size):
        batch = random.sample(self.buf, batch_size) #выбираем определённое количество случайных элементов
        s, a, r, s2, d = zip(*batch)
        return (
            torch.FloatTensor(np.array(s)), #тензор из float32
            torch.LongTensor(np.array(a, dtype=np.int64)),
            torch.FloatTensor(r),
            torch.FloatTensor(np.array(s2)),
            torch.FloatTensor(d),
        )

    def __len__(self):
        return len(self.buf)


class DQNAgent:
    def __init__(self):
        self.policy_net = QNetwork() # сеть, которую обучаем
        self.target_net = QNetwork() # стабильная копия для вычисления целевых Q
        self.target_net.load_state_dict(self.policy_net.state_dict()) #state_dict для получения словаря из всех весов и смещений
        self.target_net.eval() #переключение в режим оценки

        self.optimizer = optim.Adam(self.policy_net.parameters(), lr=LR)
        self.memory = ReplayBuffer(MEMORY_SIZE)
        self.steps = 0

    def get_obs(self, car):
        """Собрать наблюдение из машины — вектор из 8 чисел."""
        return car.norm_distance + [car.speed / MAX_SPEED] + [((CHECKPOINTS[car.current_checkpoint_idx][0] - car.x) / WIDTH) + ((CHECKPOINTS[car.current_checkpoint_idx][1] - car.y) / HEIGHT)] + [math.hypot(CHECKPOINTS[car.current_checkpoint_idx][0] - car.x, CHECKPOINTS[car.current_checkpoint_idx][1] - car.y) / WIDTH]

    def choose_action(self, obs, eps):
        """Epsilon-greedy: случайно или через сеть."""
        if random.random() < eps:
            return random.randint(0, N_ACTIONS - 1)
        with torch.no_grad():
            t = torch.FloatTensor(obs).unsqueeze(0)   # [1, 6]
            q = self.policy_net(t)                     # [1, 5]
            return int(q.argmax(dim=1).item())

    def remember(self, obs, action, reward, next_obs, done):
        self.memory.push(obs, action, reward, next_obs, done)

    def learn(self):
        """Один шаг обучения — вызывается каждый игровой шаг."""
        if len(self.memory) < BATCH_SIZE:
            return None   # ждём пока наберём достаточно опыта

        s, a, r, s2, d = self.memory.sample(BATCH_SIZE)

        # Текущие Q-значения для выбранных действий
        # s - 64 * 6
        q_current = self.policy_net(s).gather(1, a.unsqueeze(1)).squeeze(1)
        # получаем 64 * 5

        # Целевые Q-значения (формула Беллмана)
        with torch.no_grad():
            q_next = self.target_net(s2).max(dim=1).values
            q_target = r + GAMMA * q_next * (1 - d)

        # ошибка -> обратное распространение
        loss = nn.MSELoss()(q_current, q_target)
        loss = nn.SmoothL1Loss()(q_current, q_target)
        self.optimizer.zero_grad()
        loss.backward()
        self.optimizer.step()

        # Периодически копируем веса в target-сеть
        self.steps += 1
        if self.steps % TARGET_UPDATE == 0:
            self.target_net.load_state_dict(self.policy_net.state_dict())

        return loss.item()

    def save(self, path="dqn_weights.pth"):
        torch.save(self.policy_net.state_dict(), path)
        print(f"Модель сохранена {path}")

    def load(self, path="dqn_weights.pth"):
        self.policy_net.load_state_dict(torch.load(path))
        self.target_net.load_state_dict(self.policy_net.state_dict())
        print(f"Модель загружена {path}")


